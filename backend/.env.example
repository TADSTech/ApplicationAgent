# JobJockey Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Project Configuration
# ============================================
PROJECT_NAME=JobJockey
API_V1_STR=/api/v1

# ============================================
# Firebase Configuration
# ============================================
# Path to Firebase credentials JSON file (optional - for local development)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Firestore project ID (required for production)
FIRESTORE_PROJECT_ID=jobjockey-default

# ============================================
# Gemini API Configuration (Critical for AI Features)
# ============================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Example: AIzaSyDxxx... (starts with AIza)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# External API Keys (Nice-to-Have - with mock fallbacks)
# ============================================
# Exchange Rate API for currency conversion (USD <-> NGN)
EXCHANGERATE_API_KEY=your-exchange-rate-api-key

# Firecrawl API for job scraping (Nice-to-Have - Mocked)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# GitHub API token for portfolio showcase
GITHUB_TOKEN=your-github-token

# HackerRank API key for skills verification (Nice-to-Have - Mocked)
HACKERRANK_API_KEY=your-hackerrank-api-key

# Dev.to API key for community contributions (Nice-to-Have - Mocked)
DEVTO_API_KEY=your-devto-api-key
